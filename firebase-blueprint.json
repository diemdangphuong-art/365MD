{
  "entities": {
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Trusted administrator registry entry keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "orgId": {
          "type": "string",
          "maxLength": 16,
          "enum": ["365MD"],
          "description": "Organization identifier."
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who granted access."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        }
      },
      "required": ["uid", "orgId", "grantedBy", "createdAt"]
    },
    "StaffPublicProfile": {
      "title": "StaffPublicProfile",
      "description": "Non-PII staff account profile and detailed RBAC permission matrix for 365MD employees.",
      "type": "object",
      "properties": {
        "staffId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique staff identifier."
        },
        "orgId": {
          "type": "string",
          "maxLength": 16,
          "enum": ["365MD"],
          "description": "Organization identifier."
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_.\\-]+$",
          "description": "Account login username."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full display name of the employee."
        },
        "employeeCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^NV-[0-9]{3,6}$",
          "description": "Employee code formatted as NV-XXX."
        },
        "role": {
          "type": "string",
          "maxLength": 32,
          "enum": ["admin", "warehouse_manager", "sales_lead", "cashier", "auditor"],
          "description": "Assigned functional role in 365MD."
        },
        "department": {
          "type": "string",
          "maxLength": 64,
          "enum": ["Ban Giám Đốc", "Kho Vận", "Kinh Doanh POS", "Kế Toán & Kiểm Toán"],
          "description": "Assigned department."
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Assigned branch or warehouse facility."
        },
        "status": {
          "type": "string",
          "maxLength": 20,
          "enum": ["active", "suspended", "offboarded"],
          "description": "Employment status."
        },
        "permInventoryView": {
          "type": "boolean",
          "description": "Permission to view warehouse inventory."
        },
        "permInventoryEdit": {
          "type": "boolean",
          "description": "Permission to create or edit SKU items and stock."
        },
        "permStockApprove": {
          "type": "boolean",
          "description": "Permission to approve inbound/outbound stock slips."
        },
        "permSalesCreate": {
          "type": "boolean",
          "description": "Permission to create POS/B2B sales orders."
        },
        "permSalesRefund": {
          "type": "boolean",
          "description": "Permission to process order refunds."
        },
        "permReportExport": {
          "type": "boolean",
          "description": "Permission to view financial analytics and export periodic PDF reports."
        },
        "permStaffManage": {
          "type": "boolean",
          "description": "Permission to manage staff accounts and RBAC permissions."
        },
        "monthlyKpiVnd": {
          "type": "number",
          "description": "Monthly sales KPI target in VND assigned by Admin."
        },
        "kpiWorkingDays": {
          "type": "number",
          "description": "Number of working days in the month to achieve KPI."
        },
        "kpiMonthStr": {
          "type": "string",
          "maxLength": 16,
          "description": "Target YYYY-MM month string for the KPI configuration."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "staffId",
        "orgId",
        "username",
        "fullName",
        "employeeCode",
        "role",
        "department",
        "branch",
        "status",
        "permInventoryView",
        "permInventoryEdit",
        "permStockApprove",
        "permSalesCreate",
        "permSalesRefund",
        "permReportExport",
        "permStaffManage",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffPrivateInfo": {
      "title": "StaffPrivateInfo",
      "description": "Isolated PII and compensation record for a staff member, accessible strictly to the owner or admin.",
      "type": "object",
      "properties": {
        "staffId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Matches staff_public document ID."
        },
        "orgId": {
          "type": "string",
          "maxLength": 16,
          "enum": ["365MD"],
          "description": "Organization identifier."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Work or personal email address (PII)."
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "description": "Phone number (PII)."
        },
        "baseSalaryVnd": {
          "type": "number",
          "description": "Monthly base compensation in VND."
        },
        "contractType": {
          "type": "string",
          "maxLength": 32,
          "enum": ["Toàn thời gian", "Bán thời gian", "Thử việc"],
          "description": "Employment contract classification."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "staffId",
        "orgId",
        "email",
        "phone",
        "baseSalaryVnd",
        "contractType",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Warehouse SKU item managed in 365MD inventory.",
