          "type": "string",
          "maxLength": 16,
          "enum": ["365MD"],
          "description": "Organization identifier."
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Stock Keeping Unit code from KiotViet."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Product commercial name."
        },
        "supplier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Supplier or distributor name."
        },
        "category": {
          "type": "string",
          "maxLength": 64,
          "description": "Product category."
        },
        "unit": {
          "type": "string",
          "maxLength": 24,
          "description": "Unit of measure."
        },
        "warehouseZone": {
          "type": "string",
          "maxLength": 64,
          "description": "Storage zone in 365MD warehouse."
        },
        "batchNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Lot or batch code."
