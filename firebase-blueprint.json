        },
        "hasContract": {
          "type": "string",
          "enum": ["Có", "Không"],
          "description": "Contract status: Có / Không."
        },
        "contractDate": {
          "type": "string",
          "maxLength": 40,
          "description": "Contract signing date (Ngày ký hợp đồng)."
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Last saved date string."
        }
      },
      "required": ["supplierId", "orgId", "name", "phone", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Registry of trusted 365MD administrators."
    },
    "/staff_public/{staffId}": {
      "schema": { "$ref": "#/entities/StaffPublicProfile" },
      "description": "Public staff profiles, usernames, and granular RBAC permissions for 365MD."
    },
    "/staff_private/{staffId}": {
      "schema": { "$ref": "#/entities/StaffPrivateInfo" },
      "description": "Strictly isolated PII (email, phone, salary) for 365MD staff."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Warehouse SKU catalog, supplier info, and real-time stock quantities."
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/SupplierCatalogItem" },
      "description": "Supplier directory with address, company name, tax ID, contract status, and contract date."
    },
    "/stock_movements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Warehouse inbound, outbound, adjustment, and sales deduction ledger."
    },
    "/sales_orders/{orderId}": {
      "schema": { "$ref": "#/entities/SalesOrder" },
      "description": "Real-time POS and B2B sales orders and revenue ledger."
    },
    "/cash_vouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/CashVoucher" },
      "description": "Cash fund and bank account receipt (Phiếu thu) and payment (Phiếu chi) financial ledger."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer directory imported from KiotViet for 365MD (vehicle owners and partner garages)."
    }
  }
}
