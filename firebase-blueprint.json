        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "productId",
        "orgId",
        "sku",
        "name",
        "supplier",
        "category",
        "unit",
        "warehouseZone",
        "batchNumber",
        "costPriceVnd",
        "sellPriceVnd",
        "stockQty",
        "minStockThreshold",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
